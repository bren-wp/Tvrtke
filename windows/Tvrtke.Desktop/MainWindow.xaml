<Window x:Class="Tvrtke.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TVRTKE – Poslovni registar" Width="1120" Height="720"
        MinWidth="700" MinHeight="470" Background="#F5F7FB">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="TVRTKE" FontSize="34" FontWeight="Bold" Foreground="#154978" />
            <TextBlock Text="Poslovni registar Hrvatske" FontSize="15" Foreground="#58677A" />
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="QueryInput" FontSize="16" Padding="9" BorderBrush="#C9D4DF"
                         ToolTip="Upišite naziv tvrtke, OIB ili MBS" KeyDown="QueryInput_KeyDown"/>
                <Button Grid.Column="1" Content="Pretraži" Margin="12,0,0,0" Width="125" Click="Search_Click" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DataGrid x:Name="ResultsGrid" Grid.Column="0" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal"
                          SelectionChanged="ResultsGrid_SelectionChanged" HeadersVisibility="Column"
                          Margin="0,0,14,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="OIB" Binding="{Binding Oib}" Width="118"/>
                        <DataGridTextColumn Header="Mjesto" Binding="{Binding Settlement}" Width="145"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Column="1" Margin="10" >
                    <TextBlock Text="Detalji subjekta" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <TextBlock Text="Naziv" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedSubject.Name}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <TextBlock Text="MBS" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedSubject.Mbs}" Margin="0,4,0,12"/>
                    <TextBlock Text="OIB" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedSubject.Oib}" Margin="0,4,0,12"/>
                    <TextBlock Text="Županija" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedSubject.County}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <TextBlock Text="Adresa" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedSubject.Address}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                </StackPanel>
            </Grid>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Text="Spremno za pretragu" Foreground="#526173" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PreviousButton" Content="Prethodna" Click="Previous_Click" IsEnabled="False" Margin="0,0,7,0"/>
                <TextBlock x:Name="PageText" Text="1" VerticalAlignment="Center" Margin="10,0"/>
                <Button x:Name="NextButton" Content="Sljedeća" Click="Next_Click" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
