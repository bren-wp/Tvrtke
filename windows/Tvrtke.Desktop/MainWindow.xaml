<Window x:Class="Tvrtke.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TVRTKE — Poslovni imenik Hrvatske"
        Width="1448" Height="960" MinWidth="540" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#EFF7FA"
        FontFamily="Segoe UI" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Navy" Color="#0B2D4A"/>
        <SolidColorBrush x:Key="Teal" Color="#00AFA9"/>
        <SolidColorBrush x:Key="Muted" Color="#607A96"/>
        <SolidColorBrush x:Key="Line" Color="#DDE9F2"/>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="47"/><Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="18,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#183C62"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E6F6F7"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#DDF6F5"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#00AFA9"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#00AFA9"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,9"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="43"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#008F91"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#0B3356"/>
            <Setter Property="BorderBrush" Value="#D6E5F1"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/><Setter Property="MinHeight" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E7F7F9"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="12,7"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBDDEB"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CBDDEB"/><Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#67819D"/><Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,13"/>
            <Setter Property="BorderBrush" Value="#EDF2F7"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#073452"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ECF1F6"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DDF5F5"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EDF9FA"/></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="ShellGrid">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <!-- Reference: compact left rail, real navigation and no dummy statistics -->
        <Border x:Name="Sidebar" Grid.Column="0" Background="White" BorderBrush="#E0EDF3" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Background="#F1FAFA" Padding="18" Margin="12,8,12,16" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Foreground="#0B2D4A" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" Text="Svi poslovni subjekti Hrvatske na jednom mjestu."/>
                        <TextBlock Margin="0,9,0,0" Foreground="#647F99" FontSize="12" TextWrapping="Wrap" Text="Službeni izvori · pretraga i pregled dopuštenih zapisa"/>
                    </StackPanel>
                </Border>
                <StackPanel DockPanel.Dock="Top" Margin="18,22,10,22" Orientation="Horizontal">
                    <Border Width="53" Height="53" Background="#0B2D4A" CornerRadius="12" Margin="0,0,12,0">
                        <Grid>
                            <Path Data="M 8,40 L 8,31 L 17,24 L 17,40 Z M 20,40 L 20,15 L 30,9 L 30,40 Z M 33,40 L 33,22 L 43,31 L 43,40 Z"
                                  Fill="#15C9BD" Stretch="Uniform" Margin="10"/>
                            <Path Data="M 10,33 L 21,28 L 30,32 L 40,18" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Fill" Margin="9,10,9,10"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TVRTKE" FontWeight="ExtraBold" FontSize="24" Foreground="#0B2D4A"/>
                        <TextBlock Text="POSLOVNI IMENIK" FontSize="9" FontWeight="SemiBold" Foreground="#466887"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Style="{StaticResource NavButton}" Tag="all" Click="Category_Click" Background="#DBF6F6" Foreground="#007D83" Content="⌕   Pretraživanje"/>
                        <Button Style="{StaticResource NavButton}" Tag="sudreg" Click="Category_Click" Content="▥   Tvrtke"/>
                        <Button Style="{StaticResource NavButton}" Tag="obrt" Click="Category_Click" Content="▣   Obrti"/>
                        <Button Style="{StaticResource NavButton}" Tag="udruga" Click="Category_Click" Content="♧   Udruge"/>
                        <Button Style="{StaticResource NavButton}" Tag="zaklada" Click="Category_Click" Content="♡   Zaklade"/>
                        <Border Height="1" Background="#E1EAF1" Margin="19,17"/>
                        <Button x:Name="FavoritesButton" Style="{StaticResource NavButton}" Click="Favorites_Click" Content="☆   Moji favoriti"/>
                        <Button Style="{StaticResource NavButton}" Click="Export_Click" Content="⇩   Uvoz / Izvoz"/>
                        <Border Height="1" Background="#E1EAF1" Margin="19,17"/>
                        <Button Style="{StaticResource NavButton}" Click="Settings_Click" Content="⚙   Postavke API-ja"/>
                        <Button Style="{StaticResource NavButton}" Click="Help_Click" Content="?   Pomoć"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="WorkspaceScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <Grid x:Name="WorkspaceGrid" MinHeight="800" Margin="16,16,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="116"/>
                <RowDefinition x:Name="SearchRow" Height="160"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto" MinHeight="50"/>
            </Grid.RowDefinitions>
            <Border x:Name="HeaderCard" Grid.Row="0" Background="White" CornerRadius="13" BorderBrush="#E5EFF5" BorderThickness="1" Padding="24,17" Margin="0,0,0,11">
                <DockPanel>
                    <Border x:Name="SourceBadge" DockPanel.Dock="Right" Background="#F2F9FC" CornerRadius="9" Padding="16,10" Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="IZVORI PODATAKA" FontSize="10" Foreground="#637F9B" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SourceCountText" Text="Provjera dostupnosti…" Foreground="#008E94" FontSize="15" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Menu x:Name="CompactNavigation" DockPanel.Dock="Left" Visibility="Collapsed" Margin="0,0,12,0" VerticalAlignment="Center" Background="#E5F8F7">
                        <MenuItem Header="☰  Izbornik" Foreground="#0B2D4A" FontWeight="SemiBold">
                            <MenuItem Header="Pretraživanje" Tag="all" Click="Category_Click"/>
                            <MenuItem Header="Tvrtke" Tag="sudreg" Click="Category_Click"/>
                            <MenuItem Header="Obrti" Tag="obrt" Click="Category_Click"/>
                            <MenuItem Header="Udruge" Tag="udruga" Click="Category_Click"/>
                            <MenuItem Header="Zaklade" Tag="zaklada" Click="Category_Click"/>
                            <Separator/>
                            <MenuItem Header="Favoriti" Click="Favorites_Click"/>
                            <MenuItem Header="Izvoz (CSV)" Click="Export_Click"/>
                            <MenuItem Header="Postavke" Click="Settings_Click"/>
                            <MenuItem Header="Pomoć" Click="Help_Click"/>
                        </MenuItem>
                    </Menu>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeroTitle" Text="Pronađite prave poslovne informacije" TextWrapping="Wrap" FontWeight="Bold" FontSize="27" Foreground="#0B2D4A"/>
                        <TextBlock Text="Tvrtke, obrti, udruge i zaklade iz dostupnih javnih registara Hrvatske."
                                   Foreground="#54769A" FontSize="14" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Background="White" CornerRadius="13" BorderBrush="#E5EFF5" BorderThickness="1" Padding="16,13" Margin="0,0,0,11">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="148"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="QueryInput" ToolTip="Naziv, OIB ili registracijski broj" KeyDown="QueryInput_KeyDown"
                                 AutomationProperties.Name="Pretraživanje poslovnih subjekata" Margin="0,0,12,0"/>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="⌕  Pretraži" Click="Search_Click"/>
                    </Grid>
                    <Grid x:Name="SearchFilterGrid" Grid.Row="1" Margin="0,9,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="0"/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.15*"/><ColumnDefinition Width=".95*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="CategoryFilter" Grid.Column="0" Margin="0,0,9,0">
                            <TextBlock Text="Vrsta subjekta" FontSize="11" FontWeight="SemiBold" Foreground="#557591" Margin="2,0,0,3"/>
                            <ComboBox x:Name="CategoryInput" SelectedIndex="0" AutomationProperties.Name="Vrsta subjekta">
                                <ComboBoxItem Content="Svi subjekti" Tag="all"/><ComboBoxItem Content="Tvrtke" Tag="sudreg"/>
                                <ComboBoxItem Content="Obrti" Tag="obrt"/><ComboBoxItem Content="Udruge" Tag="udruga"/>
                                <ComboBoxItem Content="Zaklade" Tag="zaklada"/><ComboBoxItem Content="Ostali" Tag="ostalo"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="CountyFilter" Grid.Column="1" Margin="0,0,9,0">
                            <TextBlock Text="Županija" FontSize="11" FontWeight="SemiBold" Foreground="#557591" Margin="2,0,0,3"/>
                            <TextBox x:Name="CountyInput" ToolTip="Naziv županije" AutomationProperties.Name="Županija"
                                     KeyDown="QueryInput_KeyDown"/>
                        </StackPanel>
                        <StackPanel x:Name="ActivityFilter" Grid.Column="2" Margin="0,0,9,0">
                            <TextBlock Text="Djelatnost / NKD" FontSize="11" FontWeight="SemiBold" Foreground="#557591" Margin="2,0,0,3"/>
                            <TextBox x:Name="ActivityInput" ToolTip="Opis djelatnosti ili NKD" AutomationProperties.Name="Djelatnost"
                                     KeyDown="QueryInput_KeyDown"/>
                        </StackPanel>
                        <StackPanel x:Name="StatusFilter" Grid.Column="3">
                            <TextBlock Text="Status" FontSize="11" FontWeight="SemiBold" Foreground="#557591" Margin="2,0,0,3"/>
                            <ComboBox x:Name="StatusInput" SelectedIndex="0" AutomationProperties.Name="Status poslovnog subjekta">
                                <ComboBoxItem Content="Svi statusi" Tag=""/><ComboBoxItem Content="Aktivni" Tag="1"/>
                                <ComboBoxItem Content="Brisani / neaktivni" Tag="0"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Grid x:Name="ResultsLayout" Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="13"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Border x:Name="ResultsCard" Grid.Column="0" Background="White" CornerRadius="13" BorderBrush="#E0EAF3" BorderThickness="1" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="5,2,5,0">
                            <TextBlock DockPanel.Dock="Left" Text="Rezultati pretraživanja" VerticalAlignment="Center" FontSize="19" FontWeight="Bold" Foreground="#0B2D4A"/>
                            <TextBlock x:Name="ResultCountText" DockPanel.Dock="Right" Text="—" Margin="18,0,0,0"
                                       Foreground="#5F7995" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DataGrid x:Name="ResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionChanged="ResultsGrid_SelectionChanged"
                                  Background="White" BorderThickness="0" GridLinesVisibility="None"
                                  HeadersVisibility="Column" RowHeight="52" CanUserAddRows="False"
                                  RowHeaderWidth="0" ColumnHeaderHeight="42" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Naziv subjekta" Binding="{Binding Name}" Width="2.1*"/>
                                <DataGridTextColumn Header="Izvor" Binding="{Binding SourceLabel}" Width="108"/>
                                <DataGridTextColumn Header="Mjesto" Binding="{Binding Settlement}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Grid.Row="2" Margin="5,10,4,1">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="PreviousButton" Style="{StaticResource GhostButton}" Content="‹" Width="42" Click="Previous_Click" IsEnabled="False"/>
                                <TextBlock x:Name="PageText" Text="1" Margin="13,0" VerticalAlignment="Center" Foreground="#0B2D4A" FontWeight="Bold"/>
                                <Button x:Name="NextButton" Style="{StaticResource GhostButton}" Content="›" Width="42" Click="Next_Click" IsEnabled="False"/>
                            </StackPanel>
                            <TextBlock Text="Samo dostupni i objavljeni izvori" Foreground="#6E8196" VerticalAlignment="Center" FontSize="12"/>
                        </DockPanel>
                    </Grid>
                </Border>
                <Border x:Name="DetailsCard" Grid.Column="2" Background="White" CornerRadius="13" BorderBrush="#E0EAF3" BorderThickness="1" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <Button x:Name="FavoriteButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                    Content="♡  Dodaj u favorite" Click="ToggleFavorite_Click" IsEnabled="False"/>
                            <TextBlock Text="Osnovni podaci" Foreground="#0B2D4A" FontWeight="Bold" FontSize="19" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel DataContext="{Binding SelectedSubject}" Margin="0,1,7,0">
                                <Border Background="#E8F7F8" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name, TargetNullValue='Odaberite poslovni subjekt'}"
                                                   TextWrapping="Wrap" Foreground="#0B2D4A" FontWeight="Bold" FontSize="18"/>
                                        <TextBlock Text="{Binding SourceLabel}" Foreground="#007E86" FontSize="12" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding StatusLabel}" Foreground="#07896A" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="OIB" Foreground="#5C7694" FontSize="12"/><TextBlock Text="{Binding Oib}" Margin="0,3,0,10"/>
                                <TextBlock Text="MBS / broj registra" Foreground="#5C7694" FontSize="12"/>
                                <TextBlock Text="{Binding SourceIdentifier}" Margin="0,3,0,10"/>
                                <TextBlock Text="Pravni oblik" Foreground="#5C7694" FontSize="12"/>
                                <TextBlock Text="{Binding LegalForm}" TextWrapping="Wrap" Margin="0,3,0,10"/>
                                <TextBlock Text="Sjedište" Foreground="#5C7694" FontSize="12"/>
                                <TextBlock Text="{Binding Location}" TextWrapping="Wrap" Margin="0,3,0,10"/>
                                <TextBlock Text="Adresa" Foreground="#5C7694" FontSize="12"/>
                                <TextBlock Text="{Binding Address}" TextWrapping="Wrap" Margin="0,3,0,10"/>
                                <TextBlock Text="Datum osnivanja" Foreground="#5C7694" FontSize="12"/>
                                <TextBlock Text="{Binding FoundedAt}" Margin="0,3,0,10"/>
                                <TextBlock Text="Datum upisa" Foreground="#5C7694" FontSize="12"/>
                                <TextBlock Text="{Binding RegisteredAt}" Margin="0,3,0,10"/>
                                <TextBlock Text="Datum brisanja / prestanka" Foreground="#5C7694" FontSize="12"/>
                                <TextBlock Text="{Binding DeletedAt}" Margin="0,3,0,10"/>
                                <TextBlock Text="Datum promjene statusa" Foreground="#5C7694" FontSize="12"/>
                                <TextBlock Text="{Binding StatusChangedAt}" Margin="0,3,0,10"/>
                                <TextBlock Text="Registrirane djelatnosti" FontWeight="SemiBold" Foreground="#0B2D4A" Margin="0,8,0,7"/>
                                <ItemsControl ItemsSource="{Binding Activities}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <TextBlock Text="{Binding Display}" Margin="0,0,0,8" Foreground="#526B87" TextWrapping="Wrap"/>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Djelomični uvoz — podaci mogu nedostajati." TextWrapping="Wrap"
                                           Foreground="#A36B19" Visibility="{Binding PartialVisibility}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                        <Button Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource GhostButton}"
                                Content="⇩  Izvezi prikazano (CSV)" Click="Export_Click"
                                ToolTip="Izvozi samo rezultate trenutačne stranice"/>
                    </Grid>
                </Border>
            </Grid>
            <DockPanel Grid.Row="3" Margin="6,8,4,0">
                <TextBlock x:Name="StatusText" Text="Spremno za pretragu." Foreground="#52718F"
                           VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"/>
            </DockPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</Window>