<Window x:Class="Tvrtke.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TVRTKE – Poslovni imenik Hrvatske" Width="1220" Height="760"
        MinWidth="850" MinHeight="560" Background="#F4F7FB">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="37"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Postavke API-ja" Click="Settings_Click" Margin="8,0,0,0"/>
                <Button x:Name="FavoritesButton" Content="Favoriti" Click="Favorites_Click" Margin="8,0,0,0"/>
            </StackPanel><StackPanel><TextBlock Text="TVRTKE" FontSize="34" FontWeight="Bold" Foreground="#174B85"/>
            <TextBlock Text="Tvrtke, obrti, udruge i zaklade · dostupni javni registri Hrvatske" FontSize="14" Foreground="#53677A"/></StackPanel></DockPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Naziv ili registracijski broj" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="QueryInput" ToolTip="Pretraži po nazivu ili broju poslovnog subjekta" KeyDown="QueryInput_KeyDown"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Županija" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="CountyInput" ToolTip="Početak naziva županije" KeyDown="QueryInput_KeyDown"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Djelatnost / NKD" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="ActivityInput" ToolTip="Početak opisa ili NKD šifra" KeyDown="QueryInput_KeyDown"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="Vrsta subjekta" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CategoryInput" SelectedIndex="0" MinWidth="148" Height="37">
                        <ComboBoxItem Content="Svi registri" Tag="all"/>
                        <ComboBoxItem Content="Sudski registar" Tag="sudreg"/>
                        <ComboBoxItem Content="Obrti" Tag="obrt"/>
                        <ComboBoxItem Content="Udruge" Tag="udruga"/>
                        <ComboBoxItem Content="Zaklade" Tag="zaklada"/>
                        <ComboBoxItem Content="Ostali" Tag="ostalo"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,10,0">
                    <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="StatusInput" SelectedIndex="0" MinWidth="120" Height="37">
                        <ComboBoxItem Content="Svi" Tag=""/><ComboBoxItem Content="Aktivni" Tag="1"/><ComboBoxItem Content="Neaktivni" Tag="0"/>
                    </ComboBox>
                </StackPanel>
                <Button Grid.Column="5" Content="Pretraži" Width="110" VerticalAlignment="Bottom" Click="Search_Click" Background="#174B85" Foreground="White" BorderThickness="0"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <DataGrid x:Name="ResultsGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          SelectionChanged="ResultsGrid_SelectionChanged" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          BorderThickness="0" AlternatingRowBackground="#F7FAFD" RowHeight="40" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Izvor" Binding="{Binding SourceLabel}" Width="100"/>
                        <DataGridTextColumn Header="OIB" Binding="{Binding Oib}" Width="118"/>
                        <DataGridTextColumn Header="Mjesto" Binding="{Binding Settlement}" Width="*"/>
                        <DataGridTextColumn Header="Oblik" Binding="{Binding LegalFormShort}" Width="80"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="105"/>
                    </DataGrid.Columns>
                </DataGrid>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#E9EFF5"/>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="14,0,0,0">
                    <StackPanel DataContext="{Binding SelectedSubject}">
                        <TextBlock Text="Profil subjekta" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <TextBlock Text="Naziv" Foreground="#5C6C7C"/>
                        <TextBlock Text="{Binding Name, TargetNullValue='Odaberite subjekt'}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,13"/>
                        <TextBlock Text="Izvor i broj registra" Foreground="#5C6C7C"/>
                        <TextBlock Text="{Binding SourceLabel}" Margin="0,3,0,2"/>
                        <TextBlock Text="{Binding SourceIdentifier}" Margin="0,0,0,9"/>
                        <TextBlock Text="MBS / OIB" Foreground="#5C6C7C"/>
                        <TextBlock Text="{Binding Mbs}" Margin="0,3,0,2"/>
                        <TextBlock Text="{Binding Oib}" Margin="0,0,0,13"/>
                        <TextBlock Text="Pravni oblik" Foreground="#5C6C7C"/>
                        <TextBlock Text="{Binding LegalForm}" TextWrapping="Wrap" Margin="0,3,0,13"/>
                        <TextBlock Text="Status" Foreground="#5C6C7C"/>
                        <TextBlock Text="{Binding StatusLabel}" Margin="0,3,0,13"/>
                        <TextBlock Text="Datum osnivanja" Foreground="#5C6C7C"/>
                        <TextBlock Text="{Binding FoundedAt}" Margin="0,3,0,13"/>
                        <TextBlock Text="Datum brisanja" Foreground="#5C6C7C"/>
                        <TextBlock Text="{Binding DeletedAt}" Margin="0,3,0,13"/>
                        <TextBlock Text="Datum upisa u registar" Foreground="#5C6C7C"/>
                        <TextBlock Text="{Binding RegisteredAt}" Margin="0,3,0,13"/>
                        <TextBlock Text="Datum promjene statusa" Foreground="#5C6C7C"/>
                        <TextBlock Text="{Binding StatusChangedAt}" Margin="0,3,0,13"/>
                        <TextBlock Text="Županija i mjesto" Foreground="#5C6C7C"/>
                        <TextBlock Text="{Binding Location}" TextWrapping="Wrap" Margin="0,3,0,13"/>
                        <TextBlock Text="Adresa" Foreground="#5C6C7C"/>
                        <TextBlock Text="{Binding Address}" TextWrapping="Wrap" Margin="0,3,0,13"/>
                        <TextBlock Text="Registrirane djelatnosti" Foreground="#5C6C7C"/>
                        <ItemsControl ItemsSource="{Binding Activities}" Margin="0,5,0,0">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="0,2,0,8"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Djelomični uvoz – podaci mogu nedostajati." Foreground="#946200" Visibility="{Binding PartialVisibility}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" Text="Spremno za pretragu" Foreground="#526173" DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="FavoriteButton" Content="Dodaj u favorite" IsEnabled="False" Click="ToggleFavorite_Click" Margin="0,0,14,0"/>
                <Button Content="Izvezi prikazano (CSV)" Click="Export_Click" Margin="0,0,14,0" ToolTip="Izvozi samo rezultate trenutačne stranice"/>
                <Button x:Name="PreviousButton" Content="Prethodna" Click="Previous_Click" IsEnabled="False" Margin="0,0,7,0"/>
                <TextBlock x:Name="PageText" Text="1" VerticalAlignment="Center" Margin="10,0"/>
                <Button x:Name="NextButton" Content="Sljedeća" Click="Next_Click" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
