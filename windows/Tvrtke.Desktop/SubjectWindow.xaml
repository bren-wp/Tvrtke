<Window x:Class="Tvrtke.Desktop.SubjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TVRTKE — Profil poslovnog subjekta"
        Width="960" Height="730" MinWidth="390" MinHeight="390"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="#EFF7FA" FontFamily="Segoe UI" Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0B2D4A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="19"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#315979"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <DataTemplate x:Key="ProfileRowTemplate">
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#647F99"
                           FontSize="13" Margin="0,9,12,8" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="1" Text="{Binding Value, TargetNullValue='—'}"
                           Foreground="#143C60" FontSize="13" Margin="0,9,0,8" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="17">
        <Grid.RowDefinitions>
            <RowDefinition Height="160"/><RowDefinition Height="*"/><RowDefinition Height="48"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="12" Background="White" BorderBrush="#DDE9F2"
                BorderThickness="1" Padding="21,17" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="65" Height="65" CornerRadius="12" Background="#E4F5FB"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Viewbox Margin="12">
                        <Canvas Width="48" Height="48">
                            <Path Data="M7 43 V14 L24 4 L40 14 V43 M14 20 H17 M24 20 H27 M33 20 H36 M14 28 H17 M24 28 H27 M33 28 H36 M3 44 H45"
                                  Stroke="#0B466F" StrokeThickness="2.5" StrokeStartLineCap="Round" Fill="Transparent"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="CompanyName" Text="{Binding Name}" TextWrapping="Wrap"
                               FontWeight="Bold" FontSize="27" Foreground="#0B2D4A" MaxHeight="72"/>
                    <WrapPanel Margin="0,9,0,0">
                        <Border Background="#D8F8E9" Padding="9,5" CornerRadius="8" Margin="0,0,9,5">
                            <TextBlock Text="{Binding StatusLabel}" Foreground="#0A8365" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <Border Background="#E7F1FC" Padding="9,5" CornerRadius="8" Margin="0,0,9,5">
                            <TextBlock Text="{Binding SourceLabel}" Foreground="#0B5487" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <TextBlock Text="{Binding OibLabel}" Foreground="#526D8C" Margin="0,5,0,5" FontSize="12"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#DDE9F2" BorderThickness="1">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabItem Header="Osnovni podaci">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="15">
                        <Grid x:Name="InfoGrid">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="BasicInfoCard" Grid.Row="0" Grid.Column="0" Background="#FFFFFF"
                                    BorderBrush="#E7F0F5" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Registracijski podaci" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/>
                                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ProfileRowTemplate}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="LocationCard" Grid.Row="0" Grid.Column="2" Background="#F7FBFD"
                                    BorderBrush="#E7F0F5" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Sjedište i status" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                    <TextBlock Text="Adresa" Foreground="#66809B" FontSize="12"/>
                                    <TextBlock Text="{Binding Address}" Foreground="#173C5C" TextWrapping="Wrap" Margin="0,6,0,15"/>
                                    <TextBlock Text="Mjesto i županija" Foreground="#66809B" FontSize="12"/>
                                    <TextBlock Text="{Binding Location}" Foreground="#173C5C" TextWrapping="Wrap" Margin="0,6,0,15"/>
                                    <TextBlock Text="Status" Foreground="#66809B" FontSize="12"/>
                                    <TextBlock Text="{Binding StatusLabel}" Foreground="#0A8365" Margin="0,6,0,15" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ProvenanceNote}" Foreground="#627C96" TextWrapping="Wrap" FontSize="12" Margin="0,15,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Djelatnosti">
                    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Registrirane djelatnosti" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/>
                            <TextBlock Text="{Binding ActivitiesNote}" Foreground="#657F98" Margin="0,0,0,12" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding Activities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E5EFF4" BorderThickness="0,0,0,1" Padding="9">
                                            <TextBlock Text="{Binding Display}" Foreground="#224D72" TextWrapping="Wrap" FontSize="13"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Izvor i ažuriranje">
                    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Službeni izvor zapisa" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding SourceLabel}" FontSize="16" FontWeight="SemiBold" Foreground="#0A6190"/>
                            <TextBlock Text="Broj u registru" Foreground="#647F99" Margin="0,18,0,3"/>
                            <TextBlock Text="{Binding SourceIdentifier}" FontWeight="SemiBold" Foreground="#0B2D4A"/>
                            <TextBlock Text="Podaci se preuzimaju iz objavljene snimke centralnog API-ja." TextWrapping="Wrap"
                                       Margin="0,20,0,12" Foreground="#526E89"/>
                            <TextBlock Text="{Binding ProvenanceNote}" TextWrapping="Wrap" Foreground="#986A29"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
        <DockPanel Grid.Row="2" Margin="3,10,3,0">
            <TextBlock Text="TVRTKE · Poslovni imenik Hrvatske" Foreground="#6A8095"
                       VerticalAlignment="Center" FontSize="12"/>
            <Button Content="Zatvori" DockPanel.Dock="Right" Width="108" Height="37"
                    Background="#0B2D4A" Foreground="White" BorderThickness="0"
                    Click="Close_Click" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>